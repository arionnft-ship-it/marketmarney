new_adapt=r"""    private void adapt(WebView v,String url){
        if(destroyed||v!=web||!own(url)||!Recovery414.sameDocument(url,v.getUrl())||url.equals(lastAdaptedDocument))return;
        lastAdaptedDocument=url;
        Uri expected=Uri.parse(url);
        v.getSettings().setMediaPlaybackRequiresUserGesture(!"/beranda-trader.html".equals(expected.getPath()));
