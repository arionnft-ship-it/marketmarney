#!/usr/bin/env python3
"""Apply Marney 4.27 speed and stability patch to verified 4.26 source."""
from pathlib import Path
import hashlib
import json
import re
import shutil
import sys

root=Path(sys.argv[1]) if len(sys.argv)>1 else Path('android427')
patch=Path(__file__).resolve().parent

def sha(path:Path)->str:
    return hashlib.sha256(path.read_bytes()).hexdigest()

def inventory(base:Path):
    return {p.relative_to(base).as_posix():sha(p) for p in base.rglob('*') if p.is_file()}

def replace(relative:str,old:str,new:str,count:int=1):
    path=root/relative
    text=path.read_text()
    actual=text.count(old)
    assert actual==count,f'{relative}: expected {count}, found {actual}: {old[:120]!r}'
    path.write_text(text.replace(old,new,count))

def replace_block(relative:str,start_marker:str,end_marker:str,new_block:str):
    path=root/relative
    text=path.read_text()
    start=text.index(start_marker)
    end=text.index(end_marker,start)
    path.write_text(text[:start]+new_block+text[end:])

required={
    'app/build.gradle':[
        "applicationId 'com.marketmarney.mobile.beta426'",
        'versionCode 30',"versionName '4.26.0-beta'"],
    'app/src/main/java/com/marketmarney/mobile/MainActivity.java':[
        'MarketMarneyAndroid/4.26 AppShell','MarketMarney 4.26.0-beta',
        'lightCss=asset("light425.css")+"\\n"+asset("soft426.css")',
        'private void adapt(WebView v,String url)'],
    'app/src/main/java/com/marketmarney/mobile/AppResources49.java':['Cache-Control","no-store"'],
    'app/src/main/assets/light425.js':['window.MMLight425','bodyObserver','appObserver'],
    'app/src/main/res/values/strings.xml':['Marney 4.26'],
}
for relative,markers in required.items():
    text=(root/relative).read_text()
    for marker in markers: assert marker in text,f'{relative} lacks {marker!r}'

before=inventory(root)

# Version/package/report.
replace('app/build.gradle',"applicationId 'com.marketmarney.mobile.beta426'","applicationId 'com.marketmarney.mobile.beta427'")
replace('app/build.gradle','versionCode 30','versionCode 31')
replace('app/build.gradle',"versionName '4.26.0-beta'","versionName '4.27.0-beta'")
replace('app/src/main/res/values/strings.xml','<string name="app_name">Marney 4.26</string>','<string name="app_name">Marney 4.27 Speed</string>')

# Existing regression tests should identify the current release.
for relative in [
    'app/src/androidTest/java/com/marketmarney/mobile/Stability414Test.java',
    'app/src/androidTest/java/com/marketmarney/mobile/LightOnly425Test.java',
]:
    path=root/relative
    if path.exists():
        text=path.read_text()
        text=text.replace('4.26.0-beta','4.27.0-beta')
        path.write_text(text)

main='app/src/main/java/com/marketmarney/mobile/MainActivity.java'
