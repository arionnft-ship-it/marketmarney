FROM python:3.12-slim-bookworm AS brandbuild
WORKDIR /build/marney-brand
RUN pip install --no-cache-dir Pillow==11.3.0
COPY marney-brand/source.png marney-brand/build-assets.py ./
RUN python build-assets.py

FROM node:22-bookworm-slim
WORKDIR /opt/warxau-fbs
COPY warxau-fbs/package.json warxau-fbs/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY warxau-fbs/performance-runtime.cjs warxau-fbs/performance-news.cjs warxau-fbs/performance-warxau.cjs ./
COPY warxau-fbs/relay.cjs warxau-fbs/page.cjs warxau-fbs/client.js warxau-fbs/bootstrap.cjs ./
COPY warxau-fbs/topchat.cjs warxau-fbs/topchat-layout.js warxau-fbs/topchat.css warxau-fbs/start-topchat.cjs ./
COPY warxau-fbs/btc-feed.js warxau-fbs/btc-addon.cjs warxau-fbs/start-btc.cjs ./
COPY warxau-fbs/oil-feed.js warxau-fbs/oil-addon.cjs warxau-fbs/oil-preload.cjs warxau-fbs/start-oil.cjs ./
COPY warxau-fbs/nasdaq-addon.cjs warxau-fbs/nasdaq-preload.cjs warxau-fbs/start-nasdaq.cjs ./
COPY warxau-fbs/ihsg-addon.cjs warxau-fbs/ihsg-preload.cjs warxau-fbs/start-ihsg.cjs ./
COPY marney-brand/branding.cjs ./branding.cjs
COPY marney-brand/install.cjs ./brand-install.cjs
COPY signup ./signup
COPY --from=brandbuild /build/marney-brand/dist ./marney-brand-assets
RUN node brand-install.cjs bootstrap.cjs && node signup/install.cjs branding.cjs
RUN for file in *.cjs *.js signup/*.cjs; do node --check "$file" || exit 1; done
ENV NODE_ENV=production
ENV NODE_OPTIONS="--require=/opt/warxau-fbs/signup/preload.cjs --require=/opt/warxau-fbs/ihsg-preload.cjs"
CMD ["node", "/opt/warxau-fbs/start-ihsg.cjs"]
