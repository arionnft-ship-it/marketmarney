FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS brandbuild
WORKDIR /build/marney-brand
RUN pip install --no-cache-dir Pillow==11.3.0
COPY marney-brand/wordmark-text-source.b64 marney-brand/build-assets.py ./
RUN python build-assets.py

FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d
WORKDIR /opt/warxau-fbs
RUN apt-get update -qq && apt-get install -y --no-install-recommends ffmpeg >/dev/null && rm -rf /var/lib/apt/lists/*
COPY warxau-fbs/package.json warxau-fbs/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY warxau-fbs/performance-runtime.cjs warxau-fbs/performance-news.cjs warxau-fbs/performance-warxau.cjs ./
COPY warxau-fbs/derived-software.cjs ./
COPY warxau-fbs/public-theme-light.cjs warxau-fbs/install-light-theme.cjs ./
RUN node install-light-theme.cjs performance-runtime.cjs
COPY warxau-fbs/relay.cjs warxau-fbs/page.cjs warxau-fbs/client.js warxau-fbs/bootstrap.cjs warxau-fbs/social-upload-preload.cjs warxau-fbs/social-upload-preload.test.cjs warxau-fbs/social-upload-runtime-patch.cjs warxau-fbs/social-upload-runtime-patch.test.cjs warxau-fbs/social-upload-sw-preload.cjs warxau-fbs/social-upload-sw-preload.test.cjs warxau-fbs/social-experience-preload.cjs warxau-fbs/social-experience-preload.test.cjs warxau-fbs/social-experience-refinement.cjs warxau-fbs/social-experience-refinement.test.cjs warxau-fbs/social-routing-fix.cjs warxau-fbs/social-routing-fix.test.cjs warxau-fbs/gateway-integrity-compat.cjs warxau-fbs/release-verification-diagnostic.cjs warxau-fbs/automatic-pivot.cjs warxau-fbs/automatic-pivot.test.cjs warxau-fbs/automatic-pivot-internal-route.cjs warxau-fbs/automatic-pivot-internal-route.test.cjs warxau-fbs/xau-public-live.cjs warxau-fbs/xau-public-live.test.cjs warxau-fbs/xau-public-live-preload.cjs warxau-fbs/xau-public-live-preload.test.cjs ./
COPY warxau-fbs/live-stream.cjs.gz.b64.01a warxau-fbs/live-stream.cjs.gz.b64.01b warxau-fbs/live-stream.cjs.gz.b64.01c warxau-fbs/live-stream.cjs.gz.b64.02a warxau-fbs/live-stream.cjs.gz.b64.02b warxau-fbs/live-stream.cjs.gz.b64.02c warxau-fbs/live-stream.cjs.gz.b64.03 warxau-fbs/live-stream-preload.cjs.gz.b64 warxau-fbs/live-stream.test.cjs.gz.b64 warxau-fbs/install-live-stream.cjs ./
RUN node install-live-stream.cjs
COPY warxau-fbs/article-reading-width.cjs ./
COPY warxau-fbs/news-ticker.cjs warxau-fbs/squawk-feed.cjs warxau-fbs/news-ticker.test.cjs ./
COPY warxau-fbs/article-publisher.cjs ./
COPY warxau-fbs/article-banner.cjs ./
COPY warxau-fbs/topchat.cjs warxau-fbs/topchat-layout.js warxau-fbs/topchat.css warxau-fbs/start-topchat.cjs ./
COPY warxau-fbs/btc-feed.js warxau-fbs/btc-addon.cjs warxau-fbs/start-btc.cjs ./
COPY warxau-fbs/oil-feed.js warxau-fbs/oil-addon.cjs warxau-fbs/oil-preload.cjs warxau-fbs/start-oil.cjs ./
COPY warxau-fbs/nasdaq-addon.cjs warxau-fbs/nasdaq-preload.cjs warxau-fbs/start-nasdaq.cjs ./
COPY warxau-fbs/ihsg-addon.cjs warxau-fbs/ihsg-preload.cjs warxau-fbs/start-ihsg.cjs ./
COPY warxau-fbs/analysis-upload.cjs warxau-fbs/analysis-upload-admin.js warxau-fbs/analysis-upload-public.js warxau-fbs/analysis-upload.css warxau-fbs/analysis-modern.css warxau-fbs/xauwar-beta.js warxau-fbs/xauwar-beta.css warxau-fbs/analysis-article.js warxau-fbs/analysis-article.css warxau-fbs/analysis-upload.test.cjs ./
COPY marney-brand/branding.cjs marney-brand/seo.cjs marney-brand/about-refresh.cjs marney-brand/about-refresh.test.cjs marney-brand/logo-asset.test.cjs marney-brand/youtube-referrer.cjs marney-brand/youtube-referrer.test.cjs marney-brand/tv-layout.cjs marney-brand/tv-layout.test.cjs marney-brand/tv-learning.cjs marney-brand/tv-learning.test.cjs marney-brand/tv-heygen-import.cjs marney-brand/tv-heygen-import.test.cjs marney-brand/tv-hedra-audio.cjs marney-brand/tv-hedra-audio.test.cjs ./
COPY marney-brand/install.cjs ./brand-install.cjs
COPY signup ./signup
COPY sidebar3d ./sidebar3d
COPY --from=brandbuild /build/marney-brand/dist ./marney-brand-assets
RUN node signup/otp/install.cjs && node signup/otp/activation.cjs && node signup/password/install.cjs && node brand-install.cjs bootstrap.cjs && node signup/install.cjs branding.cjs && node sidebar3d/install.cjs branding.cjs
RUN for file in *.cjs *.js signup/*.cjs signup/otp/*.cjs signup/password/*.cjs sidebar3d/*.cjs sidebar3d/*.js; do node --check "$file" || exit 1; done
RUN node --test news-ticker.test.cjs
RUN node --test logo-asset.test.cjs about-refresh.test.cjs youtube-referrer.test.cjs tv-layout.test.cjs tv-learning.test.cjs tv-heygen-import.test.cjs tv-hedra-audio.test.cjs analysis-upload.test.cjs live-stream.test.cjs social-experience-preload.test.cjs social-experience-refinement.test.cjs social-routing-fix.test.cjs && node social-upload-preload.test.cjs && node social-upload-runtime-patch.test.cjs && node social-upload-sw-preload.test.cjs && node automatic-pivot.test.cjs && node automatic-pivot-internal-route.test.cjs && node xau-public-live.test.cjs && node xau-public-live-preload.test.cjs
ENV NODE_ENV=production
ENV NODE_OPTIONS="--require=/opt/warxau-fbs/signup/preload.cjs --require=/opt/warxau-fbs/ihsg-preload.cjs --require=/opt/warxau-fbs/social-upload-preload.cjs --require=/opt/warxau-fbs/social-upload-runtime-patch.cjs --require=/opt/warxau-fbs/gateway-integrity-compat.cjs --require=/opt/warxau-fbs/release-verification-diagnostic.cjs --require=/opt/warxau-fbs/social-upload-sw-preload.cjs --require=/opt/warxau-fbs/live-stream-preload.cjs --require=/opt/warxau-fbs/social-experience-preload.cjs --require=/opt/warxau-fbs/social-experience-refinement.cjs --require=/opt/warxau-fbs/social-routing-fix.cjs --require=/opt/warxau-fbs/xau-public-live-preload.cjs --require=/opt/warxau-fbs/automatic-pivot.cjs --require=/opt/warxau-fbs/automatic-pivot-internal-route.cjs"
CMD ["node", "/opt/warxau-fbs/start-ihsg.cjs"]
