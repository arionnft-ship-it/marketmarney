FROM python:3.12-slim-bookworm AS brandbuild
WORKDIR /build/marney-brand
RUN pip install --no-cache-dir Pillow==11.3.0
COPY marney-brand/source.png marney-brand/build-assets.py ./
RUN python build-assets.py

FROM node:22-bookworm-slim
WORKDIR /opt/warxau-fbs
COPY warxau-fbs/package.json warxau-fbs/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY warxau-fbs/performance-runtime.cjs warxau-fbs/performance-news.cjs warxau-fbs/performance-warxau.cjs ./
COPY warxau-fbs/relay.cjs warxau-fbs/page.cjs warxau-fbs/client.js warxau-fbs/bootstrap.cjs ./
COPY warxau-fbs/topchat.cjs warxau-fbs/topchat-layout.js warxau-fbs/topchat.css warxau-fbs/start-topchat.cjs ./
COPY marney-brand/branding.cjs ./branding.cjs
COPY marney-brand/install.cjs ./brand-install.cjs
COPY --from=brandbuild /build/marney-brand/dist ./marney-brand-assets
RUN node brand-install.cjs bootstrap.cjs && node --check branding.cjs && node --check relay.cjs && node --check page.cjs && node --check client.js && node --check bootstrap.cjs && node --check topchat.cjs && node --check topchat-layout.js && node --check start-topchat.cjs
ENV NODE_ENV=production
CMD ["node", "/opt/warxau-fbs/start-topchat.cjs"]
